# Coinglass gateway (required; configured by sources.coinglass.api_key_env)
# 旧 Keystore 代理密钥格式；真实密钥仅写服务器 backend/.env，不提交到 Git。
COINGLASS_API_KEY=ks_live_xxx

# AI API (按 config.yaml 中 ai.active 选择的 provider 配置对应 key)
# OpenAI
OPENAI_API_KEY=sk-xxx
# DeepSeek
DEEPSEEK_API_KEY=sk-xxx
# 兼容旧配置: 如果上面对应的 key 为空, 会 fallback 到这个
AI_API_KEY=

# Nansen (optional, SMC smart-money confirmation layer)
NANSEN_API_KEY=

# BGeometrics bitcoin-data.com (optional, Bottom Model 链上指标补充源)
# 免费档无 key 也可用（8/h、15/day 按 IP 计）；注册 key 后按 token 计。
BGEOMETRICS_API_KEY=

# OKX (optional, for private endpoints)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Redis (optional, defaults to localhost)
REDIS_URL=redis://localhost:6379/0

# Liquidity wall archive retention / disk guard
LIQUIDITY_WALL_KEEP_DAYS=14
LIQUIDITY_WALL_DISK_HIGH_WATERMARK=0.80

# Email notifications (S级信号邮件通知)
SMTP_USER=h17665037238@163.com
SMTP_PASS=your_smtp_authorization_code
