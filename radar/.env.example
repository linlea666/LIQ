# 潜力币雷达环境变量
#
# 复制为 radar/.env 后填入真实值。
#
# 为什么凭据只走环境变量、绝不进 config.yaml：
# config.yaml 每次变更都会被**完整快照**写进 config_audit 表用于策略复盘，
# 密码一旦写进去，就会永久留在数据库、备份和研究导出文件里，无法收回。
#
# 收件人地址不是凭据，它在 config.yaml 的 email.to 里配置——
# 因为改收件人应该改变 config_hash（谁在接收警报是策略的一部分）。

# ── SMTP 凭据（可直接复用主项目 backend/.env 里的同名值） ──────────────────
SMTP_USER=
SMTP_PASS=

# ── 配置页管理令牌 ──────────────────────────────────────────────────────────
# /radar/config 配置页的写入与重启操作需要此令牌（请求头 X-Radar-Admin-Token）。
# 留空 = 管理接口整体禁用（只读接口不受影响）。
# 生成随机值：openssl rand -hex 24
RADAR_ADMIN_TOKEN=

# ── 构建指纹（由 deploy.sh 通过 build args 注入，本地开发无需填） ──────────
# APP_GIT_SHA=
# APP_BUILD_TIME=
